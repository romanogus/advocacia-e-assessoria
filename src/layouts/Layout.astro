---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';

interface ArticleMeta {
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  tags?: string[];
}

interface Props {
  title?: string;
  description?: string;
  image?: string;
  article?: ArticleMeta;
  canonical?: string;
  hideFooter?: boolean;
}

const {
  title = "Santos & Trevizan — Advocacia e Assessoria",
  description = "Santos & Trevizan — Advocacia e Assessoria Jurídica. Atendimento humanizado com alcance nacional em Direito Trabalhista, Civil e Previdenciário. Consulta online por WhatsApp, videochamada e e-mail.",
  image = "/brand.png",
  article,
  canonical,
  hideFooter = false,
} = Astro.props;

const gaId = import.meta.env.PUBLIC_GA_ID || import.meta.env.GA_ID;
const gtmId = import.meta.env.PUBLIC_GTM_ID || import.meta.env.GTM_ID || 'GTM-MPCGZR87';
const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://santostrevizan.com.br';
const canonicalUrl = canonical || new URL(Astro.url.pathname, siteUrl).toString();
const ogImageUrl = image.startsWith('http') ? image : `${siteUrl}${image.startsWith('/') ? '' : '/'}${image}`;
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="canonical" href={canonicalUrl} />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Albert+Sans:wght@400;500;600;700&family=Lora:ital,wght@0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">
		<meta name="generator" content={Astro.generator} />
		
		<!-- SEO Primary Tags -->
		<title>{title}</title>
		<meta name="title" content={title} />
		<meta name="description" content={description} />

		<!-- OpenGraph / Facebook / WhatsApp -->
		<meta property="og:type" content={article ? "article" : "website"} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:site_name" content="Santos & Trevizan — Advocacia e Assessoria" />
		<meta property="og:locale" content="pt_BR" />

		{article && (
			<>
				{article.publishedTime && <meta property="article:published_time" content={article.publishedTime} />}
				{article.modifiedTime && <meta property="article:modified_time" content={article.modifiedTime} />}
				{article.author && <meta property="article:author" content={article.author} />}
				{article.tags?.map((tag) => (
					<meta property="article:tag" content={tag} />
				))}
			</>
		)}

		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:url" content={canonicalUrl} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />

		{gtmId && (
			<!-- Google Tag Manager -->
			<script is:inline set:html={`(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
			new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
			j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
			'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
			})(window,document,'script','dataLayer','${gtmId}');`} />
			<!-- End Google Tag Manager -->
		)}

		{!gtmId && gaId && (
			<>
				<!-- Google tag (gtag.js) direct fallback -->
				<script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
				<script is:inline set:html={`
					window.dataLayer = window.dataLayer || [];
					function gtag(){dataLayer.push(arguments);}
					window.gtag = gtag;
					gtag('js', new Date());
					gtag('config', '${gaId}', {
						debug_mode: true
					});
				`} />
			</>
		)}

		<!-- Analytics Lead Tracking (dataLayer & gtag) -->
		<script is:inline set:html={`
			window.dataLayer = window.dataLayer || [];
			window.addEventListener('click', function(e) {
				var target = e.target;
				if (!target || !target.closest) return;

				// Track WhatsApp link clicks
				var waLink = target.closest('a[href*="wa.me"]');
				if (waLink) {
					var placement = waLink.getAttribute('data-analytics-placement') || 'unknown';
					var area = waLink.getAttribute('data-analytics-area') || '';
					var label = waLink.getAttribute('aria-label') || (waLink.textContent && waLink.textContent.trim()) || 'whatsapp_button';

					window.dataLayer.push({
						event: 'lead_whatsapp',
						placement: placement,
						area: area,
						event_label: label,
						link_url: waLink.href
					});

					if (typeof window.gtag === 'function') {
						window.gtag('event', 'click_whatsapp', {
							event_category: 'lead',
							event_label: label,
							placement: placement,
							area: area,
							link_url: waLink.href,
							transport_type: 'beacon'
						});
					}
				}

				// Track Email link clicks
				var emailLink = target.closest('a[href^="mailto:"]');
				if (emailLink) {
					var emailPlacement = emailLink.getAttribute('data-analytics-placement') || 'footer';
					var emailLabel = emailLink.getAttribute('aria-label') || (emailLink.textContent && emailLink.textContent.trim()) || 'email_link';

					window.dataLayer.push({
						event: 'lead_email',
						placement: emailPlacement,
						event_label: emailLabel,
						link_url: emailLink.href
					});

					if (typeof window.gtag === 'function') {
						window.gtag('event', 'click_email', {
							event_category: 'lead',
							event_label: emailLabel,
							placement: emailPlacement,
							link_url: emailLink.href,
							transport_type: 'beacon'
						});
					}
				}
			});
		`} />
	</head>
	<body class="m-0 w-full min-h-screen flex flex-col bg-[#F9F9F8]">
		{gtmId && (
			<!-- Google Tag Manager (noscript) -->
			<noscript><iframe src={`https://www.googletagmanager.com/ns.html?id=${gtmId}`}
			height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
			<!-- End Google Tag Manager (noscript) -->
		)}
		<Navbar />
		<main class="pt-16 min-h-screen flex-1">
			<slot />
		</main>
		{!hideFooter && <Footer />}
		<WhatsAppButton />
		<Analytics />
	</body>
</html>
