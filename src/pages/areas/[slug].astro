---
// Landing page per practice area, one per areaDeAtuacao document in Sanity (see src/lib/areas.ts).
// Built at deploy time like the home page: Sanity edits go live on the next deploy.
// Destination for Google Ads campaigns, so the only exits are WhatsApp and the other areas.
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import ArticleCTA from '../../components/blog/ArticleCTA.astro';
import { sanityClient } from 'sanity:client';
import { AREAS_QUERY, resolveArea, serviceAnchor, whatsappUrl, type Area } from '../../lib/areas';

export async function getStaticPaths() {
  const areas: Area[] = (await sanityClient.fetch(AREAS_QUERY)).map(resolveArea);
  return areas.map((area) => ({
    params: { slug: area.slug },
    props: { area, otherAreas: areas.filter((other) => other.id !== area.id) },
  }));
}

interface Props {
  area: Area;
  otherAreas: Area[];
}

const { area, otherAreas } = Astro.props;

const areaWhatsAppUrl = whatsappUrl(area.whatsappMessage);
const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://www.paloma-santos.adv.br';
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();

const steps = [
  { heading: 'Conte o seu caso', text: 'Pelo WhatsApp, você descreve a situação com as suas palavras. Tudo o que você conta fica protegido pelo sigilo profissional.' },
  { heading: 'Análise dos documentos', text: 'Avalio a sua documentação e explico, em linguagem clara, quais caminhos existem, administrativos ou judiciais.' },
  { heading: 'Acompanhamento pessoal', text: 'Se decidir seguir, acompanho o seu caso pessoalmente, por WhatsApp e videochamada, de qualquer cidade do Brasil.' },
];

const schemaJson = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      name: area.title,
      serviceType: area.title,
      description: area.seoDescription,
      url: canonicalUrl,
      areaServed: { '@type': 'Country', name: 'Brasil' },
      provider: {
        '@type': 'Attorney',
        name: 'Paloma Santos — Advocacia Especializada',
        url: siteUrl,
        image: `${siteUrl}/brand-emblem.png`,
        telephone: '+55-11-95530-4453',
        address: { '@type': 'PostalAddress', addressLocality: 'São Paulo', addressRegion: 'SP', addressCountry: 'BR' },
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Início', item: `${siteUrl}/` },
        { '@type': 'ListItem', position: 2, name: 'Áreas de Atuação', item: `${siteUrl}/#areas` },
        { '@type': 'ListItem', position: 3, name: area.title, item: canonicalUrl },
      ],
    },
  ],
};

const crumbLink = "hover:text-[#7D5F23] transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#B8924A] rounded";
---

<Layout title={area.seoTitle} description={area.seoDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(schemaJson)} />

  <!-- Hero -->
  <section class="bg-slate-50 relative overflow-hidden">
    <div class="absolute bottom-0 left-0 right-0 h-2 bg-gradient-to-r from-[#B8924A] via-[#D4A857] to-[#F0D080]" aria-hidden="true"></div>
    <div class="max-w-4xl mx-auto px-4 sm:px-6 md:px-8 pt-8 pb-14 sm:pt-10 sm:pb-20">
      <nav aria-label="Trilha de navegação" class="mb-8 sm:mb-10">
        <ol class="flex flex-wrap items-center gap-2 text-sm text-slate-600">
          <li><a href="/" class={crumbLink}>Início</a></li>
          <li class="select-none" aria-hidden="true">/</li>
          <li><a href="/#areas" class={crumbLink}>Áreas de Atuação</a></li>
          <li class="select-none" aria-hidden="true">/</li>
          <li class="text-[#7D5F23] font-semibold" aria-current="page">{area.title}</li>
        </ol>
      </nav>

      <div class="flex items-center gap-3 mb-4">
        {area.icon && <div set:html={area.icon} class="shrink-0 [&>svg]:size-9" />}
        <p class="text-sm font-semibold uppercase tracking-wider text-[#7D5F23]">{area.title}</p>
      </div>

      <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold leading-tight text-[#1D2A3D] max-w-3xl">
        {area.headline}
      </h1>
      <p class="mt-5 text-lg sm:text-xl text-slate-700 leading-relaxed max-w-2xl">
        {area.intro}
      </p>

      <div class="mt-8 flex flex-col sm:flex-row sm:items-center gap-4 sm:gap-6">
        <a
          href={areaWhatsAppUrl}
          target="_blank"
          rel="noopener noreferrer"
          data-analytics-placement="area_hero"
          data-analytics-area={area.key}
          class="w-full sm:w-auto inline-flex items-center justify-center gap-3 px-8 py-4 bg-[#25D366] hover:bg-[#20ba56] text-[#1D2A3D] text-lg font-bold rounded-lg shadow-lg hover:shadow-xl transition-all duration-300 hover:scale-[1.02] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#B8924A] focus-visible:ring-offset-2"
          aria-label={`Falar com a advogada sobre ${area.title} via WhatsApp`}
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="#1D2A3D" class="shrink-0" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          <span>Falar com a advogada</span>
        </a>
        <p class="text-sm text-slate-600 leading-snug">
          <span class="font-semibold text-[#1D2A3D]">Dra. Paloma Santos</span> · OAB/SP 490.797<br />
          Atendimento 100% digital em todo o Brasil
        </p>
      </div>
    </div>
  </section>

  <!-- Services -->
  {area.services.length > 0 && (
    <section aria-labelledby="servicos-title" class="py-16 md:py-20 bg-[#1D2A3D]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 md:px-8">
        <h2 id="servicos-title" class="text-3xl md:text-4xl font-bold text-white mb-10">Como posso ajudar</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8">
          {area.services.map((service) => (
            <article id={serviceAnchor(service.heading)} class="scroll-mt-24 bg-[#243350] border border-[#B8924A]/25 rounded-xl p-6 sm:p-7">
              <h3 class="text-xl font-semibold leading-snug mb-3 text-[#D4A857]">{service.heading}</h3>
              <p class="text-slate-300 text-base leading-relaxed">{service.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- How it works -->
  <section aria-labelledby="como-funciona-title" class="py-16 md:py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 md:px-8">
      <h2 id="como-funciona-title" class="text-3xl md:text-4xl font-bold text-[#1D2A3D] mb-10">Como funciona o atendimento</h2>
      <ol class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-10">
        {steps.map((step, i) => (
          <li class="flex gap-4">
            <span class="shrink-0 size-10 rounded-full bg-[#1D2A3D] text-[#F0D080] font-serif text-lg font-bold flex items-center justify-center" aria-hidden="true">{i + 1}</span>
            <div>
              <h3 class="text-lg font-semibold text-[#1D2A3D] mb-1">{step.heading}</h3>
              <p class="text-slate-600 leading-relaxed">{step.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- FAQ -->
  {area.faq.length > 0 && (
    <section aria-labelledby="duvidas-title" class="pt-16 md:pt-20 pb-6 bg-slate-50">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 md:px-8">
        <h2 id="duvidas-title" class="text-3xl md:text-4xl font-bold text-[#1D2A3D] mb-8">Dúvidas frequentes</h2>
        <div class="divide-y divide-slate-200 border-y border-slate-200">
          {area.faq.map((item) => (
            <details class="group">
              <summary class="flex cursor-pointer list-none items-start justify-between gap-4 py-5 font-serif text-lg font-semibold text-[#1D2A3D] hover:text-[#7D5F23] transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#B8924A] rounded [&::-webkit-details-marker]:hidden">
                <span>{item.question}</span>
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="mt-1 size-5 shrink-0 text-[#B8924A] transition-transform duration-200 group-open:rotate-45" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                  <path d="M12 5v14M5 12h14" />
                </svg>
              </summary>
              <p class="pb-5 text-slate-600 leading-relaxed max-w-[65ch]">{item.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Closing CTA -->
  <section class="pb-16 md:pb-20 bg-slate-50">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 md:px-8">
      <ArticleCTA
        title="Quer entender o seu caso?"
        description="Conte a sua situação pelo WhatsApp. Explico os caminhos possíveis com clareza e sigilo."
        buttonText="Falar com a advogada no WhatsApp"
        whatsappMessage={area.whatsappMessage}
        placement="area_cta"
        area={area.key}
      />
      <p class="text-sm text-slate-500 leading-relaxed">
        As informações desta página têm caráter informativo e não substituem a análise individual do seu caso.
      </p>
    </div>
  </section>

  <!-- Other areas -->
  {otherAreas.length > 0 && (
    <section aria-labelledby="outras-areas-title" class="py-12 md:py-16 bg-white border-t border-slate-200">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 md:px-8">
        <h2 id="outras-areas-title" class="text-2xl font-bold text-[#1D2A3D] mb-6">Outras áreas de atuação</h2>
        <ul class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {otherAreas.map((other) => (
            <li>
              <a
                href={`/areas/${other.slug}`}
                class="group flex h-full items-center justify-between gap-4 rounded-xl border border-slate-200 bg-slate-50 p-5 hover:border-[#B8924A]/60 hover:bg-white transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#B8924A]"
              >
                <span>
                  <span class="block font-serif text-lg font-semibold text-[#1D2A3D]">{other.title}</span>
                  <span class="mt-1 block text-sm text-slate-600 leading-relaxed">{other.description}</span>
                </span>
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-[#B8924A] transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}
</Layout>
