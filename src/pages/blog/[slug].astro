---
export const prerender = false;

import { sanityClient } from 'sanity:client';
import Layout from '../../layouts/Layout.astro';
import PortableTextRenderer from '../../components/blog/PortableTextRenderer.astro';
import AuthorBio from '../../components/blog/AuthorBio.astro';
import ArticleCTA from '../../components/blog/ArticleCTA.astro';
import { urlForImage } from '../../lib/sanity.image';
import { exemplarPost } from '../../lib/exemplarPost';
import { getReadingTimeMinutes } from '../../lib/readingTime';

const { slug } = Astro.params;

let post = await sanityClient.fetch(
  `*[_type == "post" && slug.current == $slug && status == "publicado"][0] {
    _id,
    title,
    slug,
    excerpt,
    publishedAt,
    mainImage,
    body,
    author->{ name, role, image, bio },
    categories[]->{ title, slug }
  }`,
  { slug }
);

// Fallback to exemplar post if matching slug
if (!post && slug === exemplarPost.slug.current) {
  post = exemplarPost;
}

if (!post) {
  return Astro.redirect('/404');
}

const primaryCategory = post.categories?.[0]?.title || 'Direito Previdenciário';
const authorName = post.author?.name || 'Dra. Paloma André dos Santos';
const authorRole = post.author?.role || 'Advogada — Especialista em Direito Previdenciário e Trabalhista';

const coverUrl = post.mainImage
  ? urlForImage(post.mainImage)?.width(1200).height(675).url()
  : null;

const authorImageUrl = post.author?.image
  ? urlForImage(post.author.image)?.width(96).height(96).url()
  : null;

const formattedDate = post.publishedAt
  ? new Date(post.publishedAt).toLocaleDateString('pt-BR', {
      day: 'numeric',
      month: 'long',
      year: 'numeric',
    })
  : null;

// Estimate reading time from text content using shared utility
const textForEstimate = `${post.title} ${post.excerpt || ''} ${JSON.stringify(post.body || '')}`;
const readingTimeMinutes = getReadingTimeMinutes(textForEstimate);

// Check if an in-body CTA is already present to prevent redundant CTA clustering
const hasInBodyCta = Array.isArray(post.body) && post.body.some((b: any) => b._type === 'articleCta');

const canonicalUrl = new URL(Astro.url.pathname, 'https://santostrevizan.com.br').toString();
const shareWhatsAppUrl = `https://api.whatsapp.com/send?text=${encodeURIComponent(`${post.title} — Leia em: ${canonicalUrl}`)}`;

const schemaJson = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  description: post.excerpt,
  image: coverUrl || 'https://santostrevizan.com.br/brand.png',
  datePublished: post.publishedAt,
  author: {
    '@type': 'Person',
    name: authorName,
    jobTitle: authorRole,
  },
  publisher: {
    '@type': 'Organization',
    name: 'Santos & Trevizan — Advocacia e Assessoria',
    logo: {
      '@type': 'ImageObject',
      url: 'https://santostrevizan.com.br/brand.png',
    },
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonicalUrl,
  },
};
---

<Layout
  title={`${post.title} — Santos & Trevizan`}
  description={post.excerpt || 'Artigo jurídico por Santos & Trevizan — Advocacia e Assessoria.'}
  image={coverUrl || '/brand.png'}
  article={{
    publishedTime: post.publishedAt,
    author: authorName,
    tags: post.categories?.map((c: any) => c.title) || ['Direito'],
  }}
>
  <!-- Schema.org JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify(schemaJson)} />

  <article class="py-10 sm:py-16">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 md:px-8">
      
      <!-- Breadcrumb Navigation -->
      <nav aria-label="Trilha de navegação" class="mb-8">
        <ol class="flex flex-wrap items-center gap-2 text-xs sm:text-sm text-slate-500">
          <li>
            <a href="/" class="hover:text-[#B8924A] transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#B8924A] rounded">
              Início
            </a>
          </li>
          <li class="select-none">/</li>
          <li>
            <a href="/blog" class="hover:text-[#B8924A] transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#B8924A] rounded">
              Blog
            </a>
          </li>
          <li class="select-none">/</li>
          <li class="text-[#7D5F23] font-semibold">
            {primaryCategory}
          </li>
        </ol>
      </nav>

      <!-- Article Header -->
      <header class="mb-10 sm:mb-12">
        <div class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-[#1D2A3D]/5 text-[#1D2A3D] border border-[#1D2A3D]/10 mb-4">
          {primaryCategory}
        </div>

        <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold font-serif text-[#1D2A3D] tracking-tight leading-[1.2] mb-6">
          {post.title}
        </h1>

        {post.excerpt && (
          <p class="text-lg sm:text-xl text-slate-600 leading-relaxed font-normal mb-8 pb-8 border-b border-slate-200/80">
            {post.excerpt}
          </p>
        )}

        <!-- Author, Date & Share Metadata Bar -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 py-2">
          <!-- Author info -->
          <div class="flex items-center gap-3">
            {authorImageUrl ? (
              <img
                src={authorImageUrl}
                alt={authorName}
                width="48"
                height="48"
                class="w-12 h-12 rounded-full object-cover border-2 border-[#B8924A]/40"
              />
            ) : (
              <div class="w-12 h-12 rounded-full bg-[#1D2A3D] text-[#F0D080] font-serif text-base font-bold flex items-center justify-center border-2 border-[#B8924A]/40">
                PS
              </div>
            )}
            <div>
              <p class="font-serif font-bold text-[#1D2A3D] text-base leading-snug">
                {authorName}
              </p>
              <div class="flex items-center gap-2 text-xs text-slate-500">
                {formattedDate && <time>{formattedDate}</time>}
                <span>•</span>
                <span>{readingTimeMinutes} min de leitura</span>
              </div>
            </div>
          </div>

          <!-- Share buttons -->
          <div class="flex items-center gap-2">
            <span class="text-xs text-slate-500 font-medium mr-1 hidden sm:inline">Compartilhar:</span>
            <a
              href={shareWhatsAppUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 px-3.5 py-2.5 min-h-[44px] rounded-xl bg-slate-100 hover:bg-slate-200 text-[#1D2A3D] font-medium text-xs sm:text-sm border border-slate-200/80 shadow-2xs transition-all duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#B8924A]"
              aria-label="Compartilhar este artigo com contatos"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 shrink-0 text-[#1D2A3D]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />
              </svg>
              <span>Compartilhar</span>
            </a>

            <button
              id="copy-link-btn"
              type="button"
              class="inline-flex items-center justify-center gap-2 px-3.5 py-2.5 min-h-[44px] rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 font-medium text-xs sm:text-sm border border-slate-200/80 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#B8924A]"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
              </svg>
              <span id="copy-text">Copiar Link</span>
            </button>
          </div>
        </div>
      </header>

      <!-- Cover Image (if available) -->
      {coverUrl && (
        <div class="mb-12 overflow-hidden rounded-2xl border border-slate-200 shadow-md aspect-[16/9] bg-[#1D2A3D]">
          <img
            src={coverUrl}
            alt={post.mainImage?.alt || post.title}
            width="1200"
            height="675"
            class="w-full h-full object-cover"
            loading="eager"
          />
        </div>
      )}

      <!-- Main Article Content (PortableText) -->
      <div class="py-4">
        <PortableTextRenderer value={post.body} />
      </div>

      <!-- Closing Lead Gen CTA (adapts context if an in-body CTA was already placed) -->
      <ArticleCTA
        title={hasInBodyCta ? "Próximos Passos: Precisa de Análise do Seu Caso?" : "Dúvidas sobre o conteúdo deste artigo?"}
        description={hasInBodyCta ? "Nossa equipe jurídica especializada pode analisar a sua documentação e traçar a melhor estratégia para resguardar seus direitos de forma sigilosa." : "Se você está enfrentando uma situação semelhante, agende uma conversa com nossos advogados pelo WhatsApp para esclarecer seu caso de forma sigilosa."}
        buttonText="Agendar Análise pelo WhatsApp"
        articleTitle={post.title}
      />

      <!-- Author Bio Card -->
      <AuthorBio
        name={authorName}
        role={authorRole}
        bio={post.author?.bio}
        image={post.author?.image}
        oab={post.author?.oab || "Inscrição OAB/SP"}
      />

      <!-- Back to Blog Link -->
      <div class="mt-8 pt-8 border-t border-slate-200 flex justify-between items-center">
        <a
          href="/blog"
          class="inline-flex items-center gap-2 font-semibold text-[#1D2A3D] hover:text-[#B8924A] transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#B8924A] rounded"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
          <span>Voltar para a lista de artigos</span>
        </a>
      </div>

    </div>
  </article>
</Layout>

<script>
  // Copy Link Button handler
  const copyBtn = document.getElementById('copy-link-btn');
  const copyText = document.getElementById('copy-text');

  copyBtn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(window.location.href);
      if (copyText) {
        copyText.textContent = 'Link copiado!';
        setTimeout(() => {
          copyText.textContent = 'Copiar Link';
        }, 2500);
      }
    } catch {
      window.prompt('Copie o endereço do artigo:', window.location.href);
    }
  });
</script>
