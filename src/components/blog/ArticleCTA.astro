---
interface Props {
  title?: string;
  description?: string;
  buttonText?: string;
  whatsappMessage?: string;
  articleTitle?: string;
}

const {
  title = "Precisa de orientação jurídica sobre este assunto?",
  description = "Nossa equipe especializada pode analisar a sua documentação e esclarecer suas dúvidas com atendimento humanizado e alcance nacional.",
  buttonText = "Falar com Advogada no WhatsApp",
  whatsappMessage,
  articleTitle,
} = Astro.props;

const phone = "5511955304453";
const defaultMessage = articleTitle
  ? `Olá! Li o artigo "${articleTitle}" no site e gostaria de tirar uma dúvida sobre o meu caso.`
  : "Olá! Gostaria de conversar sobre uma questão jurídica.";

const finalMessage = whatsappMessage || defaultMessage;
const whatsappUrl = `https://wa.me/${phone}?text=${encodeURIComponent(finalMessage)}`;
---

<div class="my-10 rounded-2xl bg-[#1D2A3D] p-6 sm:p-8 md:p-10 text-white shadow-xl border border-[#B8924A]/30 relative overflow-hidden">
  <!-- Subtle decorative gold glow -->
  <div class="absolute -top-24 -right-24 w-48 h-48 bg-[#B8924A]/15 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute -bottom-24 -left-24 w-48 h-48 bg-[#B8924A]/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="relative z-10 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
    <div class="max-w-xl">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#B8924A]/20 border border-[#B8924A]/40 text-[#F0D080] text-xs font-semibold uppercase tracking-wider mb-3">
        <span class="w-2 h-2 rounded-full bg-[#25D366]"></span>
        Atendimento Online Disponível
      </div>
      <h3 class="text-2xl sm:text-3xl font-bold font-serif !text-white tracking-tight mb-3" style="color: #FFFFFF !important;">
        {title}
      </h3>
      <p class="text-slate-300 text-base sm:text-lg leading-relaxed">
        {description}
      </p>
    </div>

    <div class="shrink-0 w-full md:w-auto">
      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        data-analytics-placement="blog_cta"
        aria-label={buttonText}
        class="inline-flex items-center justify-center gap-3 w-full md:w-auto px-6 py-4 rounded-xl bg-[#25D366] hover:bg-[#20ba56] text-[#1D2A3D] font-bold text-base shadow-lg hover:shadow-xl transition-all duration-200 hover:scale-[1.02] no-underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#B8924A] focus-visible:ring-offset-2 focus-visible:ring-offset-[#1D2A3D]"
        style="color: #1D2A3D !important; text-decoration: none !important;"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 shrink-0 fill-[#1D2A3D]" viewBox="0 0 24 24">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
        </svg>
        <span class="!text-[#1D2A3D] font-bold" style="color: #1D2A3D !important;">{buttonText}</span>
      </a>
    </div>
  </div>
</div>
