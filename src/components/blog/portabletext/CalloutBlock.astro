---
interface Props {
  node: {
    _type: string;
    type?: 'tip' | 'warning' | 'legal' | 'info';
    title?: string;
    text: string;
  };
}

const { node } = Astro.props;

const calloutType = node.type || 'tip';

const config = {
  tip: {
    defaultTitle: 'Dica Jurídica',
    containerClass: 'bg-amber-50/60 border-amber-200 text-[#1E293B]',
    iconBg: 'bg-amber-100 text-amber-800 border-amber-200',
    titleColor: 'text-[#1D2A3D]',
  },
  warning: {
    defaultTitle: 'Atenção aos Prazos',
    containerClass: 'bg-rose-50/60 border-rose-200 text-[#1E293B]',
    iconBg: 'bg-rose-100 text-rose-800 border-rose-200',
    titleColor: 'text-rose-900',
  },
  legal: {
    defaultTitle: 'O Que Diz a Lei',
    containerClass: 'bg-slate-50 border-[#B8924A]/30 text-[#1D2A3D]',
    iconBg: 'bg-[#1D2A3D] text-[#F0D080] border-[#B8924A]/40',
    titleColor: 'text-[#1D2A3D]',
  },
  info: {
    defaultTitle: 'Informação Importante',
    containerClass: 'bg-blue-50/60 border-blue-200 text-[#1E293B]',
    iconBg: 'bg-blue-100 text-blue-800 border-blue-200',
    titleColor: 'text-blue-900',
  },
}[calloutType] || {
  defaultTitle: 'Destaque',
  containerClass: 'bg-amber-50/60 border-amber-200 text-[#1E293B]',
  iconBg: 'bg-amber-100 text-amber-800 border-amber-200',
  titleColor: 'text-[#1D2A3D]',
};

const displayTitle = node.title || config.defaultTitle;
---

<aside class={`my-8 p-5 sm:p-6 rounded-xl border shadow-xs ${config.containerClass}`} role="note">
  <div class="flex items-start gap-3.5 sm:gap-4">
    <div class={`w-9 h-9 rounded-lg flex items-center justify-center shrink-0 border shadow-xs ${config.iconBg}`} aria-hidden="true">
      {calloutType === 'tip' && (
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
        </svg>
      )}
      {calloutType === 'warning' && (
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
      )}
      {calloutType === 'legal' && (
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3" />
        </svg>
      )}
      {calloutType === 'info' && (
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      )}
      {!['tip', 'warning', 'legal', 'info'].includes(calloutType) && (
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      )}
    </div>
    <div class="flex-1">
      <p class={`text-base font-bold font-serif mb-1.5 ${config.titleColor}`}>
        {displayTitle}
      </p>
      <p class="text-base leading-relaxed whitespace-pre-line text-slate-700">
        {node.text}
      </p>
    </div>
  </div>
</aside>
