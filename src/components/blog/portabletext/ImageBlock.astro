---
import { urlForImage } from '../../../lib/sanity.image';

interface Props {
  node: {
    _type: string;
    asset?: any;
    alt?: string;
    caption?: string;
  };
}

const { node } = Astro.props;

const imageUrl = node.asset ? urlForImage(node)?.width(1000).auto('format').url() : null;
---

{imageUrl && (
  <figure class="my-10">
    <div class="overflow-hidden rounded-2xl border border-slate-200 shadow-md">
      <img
        src={imageUrl}
        alt={node.alt || ''}
        class="w-full h-auto object-cover max-h-[550px]"
        loading="lazy"
      />
    </div>
    {node.caption && (
      <figcaption class="mt-2.5 text-center text-xs sm:text-sm text-slate-500 italic">
        {node.caption}
      </figcaption>
    )}
  </figure>
)}
