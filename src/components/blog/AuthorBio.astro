---
import { urlForImage } from '../../lib/sanity.image';

interface Props {
  name?: string;
  role?: string;
  bio?: string;
  image?: any;
  oab?: string;
}

const {
  name = "Dra. Paloma André dos Santos",
  role = "Advogada — Especialista em Direito Previdenciário e Trabalhista",
  bio = "Advogada fundadora de Santos & Trevizan, com foco em atendimento humanizado e resolução estratégica de conflitos trabalhistas e previdenciários. Atuação consultiva e contenciosa com alcance em todo o Brasil.",
  image,
  oab = "Inscrição OAB/SP",
} = Astro.props;

const imageUrl = image ? urlForImage(image)?.width(240).height(240).url() : null;
const whatsappPhone = "5511955304453";
const whatsappUrl = `https://wa.me/${whatsappPhone}?text=${encodeURIComponent(`Olá, ${name}! Li seu artigo e gostaria de tirar uma dúvida jurídica.`)}`;
---

<div class="my-12 p-6 sm:p-8 rounded-2xl bg-white border border-[#1D2A3D]/10 shadow-sm flex flex-col sm:flex-row items-start sm:items-center gap-6">
  <!-- Author Avatar -->
  <div class="shrink-0">
    {imageUrl ? (
      <img
        src={imageUrl}
        alt={name}
        width="96"
        height="96"
        class="w-20 h-20 sm:w-24 sm:h-24 rounded-full object-cover border-2 border-[#B8924A]/40 shadow-inner"
        loading="lazy"
      />
    ) : (
      <div class="w-20 h-20 sm:w-24 sm:h-24 rounded-full bg-[#1D2A3D] text-[#F0D080] font-serif text-2xl font-bold flex items-center justify-center border-2 border-[#B8924A]/40 shadow-inner">
        PS
      </div>
    )}
  </div>

  <!-- Author Details -->
  <div class="flex-1">
    <div class="flex flex-wrap items-center gap-3 mb-1">
      <h3 class="text-xl font-serif font-bold text-[#1D2A3D]">
        {name}
      </h3>
      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-[#B8924A]/15 text-[#7D5F23] border border-[#B8924A]/30">
        {oab}
      </span>
    </div>
    
    <p class="text-sm font-medium text-[#7D5F23] mb-3">
      {role}
    </p>

    <p class="text-slate-600 text-sm sm:text-base leading-relaxed mb-4">
      {bio}
    </p>

    <a
      href={whatsappUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-2.5 px-5 py-2.5 rounded-xl bg-[#25D366] hover:bg-[#20ba56] text-[#1D2A3D] font-bold text-sm shadow-xs hover:shadow-md transition-all duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#B8924A] no-underline"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 fill-[#1D2A3D] shrink-0" viewBox="0 0 24 24">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
      </svg>
      <span>Conversar diretamente com a advogada</span>
    </a>
  </div>
</div>
