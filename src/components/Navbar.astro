---
// Top navigation bar component
const navItems = [
  { href: '/', label: 'Início' },
  { href: '/#areas', label: 'Áreas de Atuação' },
  { href: '/#sobre', label: 'Sobre' },
  { href: '/blog', label: 'Blog' },
  { href: '/#contato', label: 'Contato' },
];

const whatsappPhone = "5511955304453";
const whatsappMessage = "Olá! Gostaria de mais informações sobre os serviços jurídicos.";
const whatsappUrl = `https://wa.me/${whatsappPhone}?text=${encodeURIComponent(whatsappMessage)}`;
---

<header class="fixed top-0 left-0 right-0 h-16 bg-[#D9D8D3] px-4 md:px-8 z-50 flex items-center justify-between">

  <!-- Left: Brand logo (hidden while hero is visible) -->
  <a
    id="brand-logo"
    href="/"
    aria-label="Santos & Trevizan — página inicial"
    class="transition-opacity duration-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#1D2A3D] rounded"
  >
    <img
      src="/brand-nav.webp"
      alt="Santos & Trevizan"
      width="509"
      height="142"
      class="h-10 md:h-10 w-auto object-contain"
      loading="eager"
    />
  </a>

  <!-- Right: Desktop nav -->
  <div class="hidden md:flex items-center gap-1">
    <nav class="flex items-center gap-1">
      {navItems.map((item) => (
        <a
          href={item.href}
          class="px-4 py-2 text-base font-medium rounded-lg transition-all duration-200 hover:bg-[#1D2A3D]/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#1D2A3D]"
          style="color: #1D2A3D;"
        >
          {item.label}
        </a>
      ))}
    </nav>
  </div>

  <!-- Mobile: Hamburger button (right side) -->
  <button
    id="menu-toggle"
    class="md:hidden flex flex-col justify-center items-center w-11 h-11 rounded-lg hover:bg-[#1D2A3D]/10 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#1D2A3D] relative"
    aria-label="Menu"
    aria-expanded="false"
    aria-controls="mobile-menu"
  >
    <span class="hamburger-line line-1 block w-6 h-0.5 bg-[#1D2A3D] mb-1.5 transition-all duration-300 origin-center"></span>
    <span class="hamburger-line line-2 block w-6 h-0.5 bg-[#1D2A3D] mb-1.5 transition-all duration-300"></span>
    <span class="hamburger-line line-3 block w-6 h-0.5 bg-[#1D2A3D] transition-all duration-300 origin-center"></span>
  </button>

  <!-- Mobile navigation overlay -->
  <div
    id="mobile-menu"
    class="fixed inset-0 top-16 bg-[#D9D8D3]/98 backdrop-blur-sm z-40 hidden md:hidden"
    role="dialog"
    aria-label="Menu de navegação"
  >
    <nav class="flex flex-col items-center justify-center h-full gap-4">
      {navItems.map((item) => (
        <a
          href={item.href}
          class="mobile-nav-link px-6 py-3 text-2xl font-medium rounded-lg hover:bg-[#1D2A3D]/10 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#1D2A3D]"
          style="color: #1D2A3D;"
        >
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<style>
  .menu-open .line-1 {
    transform: translateY(8px) rotate(45deg);
  }
  .menu-open .line-2 {
    opacity: 0;
    transform: scaleX(0);
  }
  .menu-open .line-3 {
    transform: translateY(-8px) rotate(-45deg);
  }
</style>

<script>
  const menuToggle = document.getElementById('menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const mobileNavLinks = document.querySelectorAll('.mobile-nav-link');
  const mainEl = document.querySelector('main');

  let isOpen = false;

  function toggleMenu() {
    isOpen = !isOpen;

    // Update aria-expanded & animate icon
    menuToggle?.setAttribute('aria-expanded', String(isOpen));
    menuToggle?.classList.toggle('menu-open', isOpen);

    const fab = document.querySelector('.whatsapp-fab');

    if (isOpen) {
      mobileMenu?.classList.remove('hidden');
      // Lock body scroll and trap focus
      document.body.style.overflow = 'hidden';
      mainEl?.setAttribute('inert', '');
      fab?.classList.add('opacity-0', 'pointer-events-none');
    } else {
      mobileMenu?.classList.add('hidden');
      // Unlock body scroll and release focus
      document.body.style.overflow = '';
      mainEl?.removeAttribute('inert');
      fab?.classList.remove('opacity-0', 'pointer-events-none');
    }
  }

  menuToggle?.addEventListener('click', toggleMenu);

  // Close menu when clicking a link
  mobileNavLinks.forEach(link => {
    link.addEventListener('click', () => {
      if (isOpen) toggleMenu();
    });
  });

  // Close menu with Escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isOpen) {
      toggleMenu();
      menuToggle?.focus();
    }
  });
</script>
